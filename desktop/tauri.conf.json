{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weaver",
  "version": "0.7.3",
  "identifier": "dev.weaver.desktop",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "externalBin": ["sidecar/weaver"],
    "resources": {
      "sidecar/_internal": "_internal"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
